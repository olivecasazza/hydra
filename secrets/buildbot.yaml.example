# buildbot-nix secrets template.
#
# Copy this file to secrets/buildbot.yaml and populate via SOPS:
#   just edit-secret secrets/buildbot.yaml
#
# The creation rule in .sops.yaml encrypts secrets/buildbot.yaml to
# root + olive + seir (the buildbot master host).
#
# All values are provisioned manually — see the ACTIVATION TODO in
# casazza-hydra's modules/nixos/buildbot.nix and in seir's default.nix.

# GitHub App private key (.pem body). Generated in GitHub App settings.
# Used to authenticate API calls + manage webhooks.
app_secret_key: |
  -----BEGIN PRIVATE KEY-----
  <paste the .pem contents here>
  -----END PRIVATE KEY-----

# Webhook secret (random 32+ char string). Configured on the GitHub App
# and sent by GitHub in the X-Hub-Signature-256 header; buildbot verifies it.
# Generate with: openssl rand -hex 32
webhook_secret: <random 32+ char hex string>

# OAuth App client secret. Pairs with the non-secret oauthId (set in
# seir's default.nix). Used for the "Log in with GitHub" button on the
# buildbot web UI.
oauth_secret: <OAuth App client secret from GitHub OAuth Apps settings>

# Worker password (random string). Shared between buildbot master and the
# local worker on seir. Generate with: openssl rand -hex 32
worker_password: <random 32+ char hex string>

# GCP service-account JSON key with artifactregistry.writer on the GAR
# repo (us-central1-docker.pkg.dev/casazza-identity/nixlab). Reuse the
# existing crosswords-ci SA (workload-identity-federated for GHA) by
# creating a key for it, OR create a new SA dedicated to buildbot.
# Paste the ENTIRE JSON body (the file you download from GCP console).
gar_sa_key: |
  {
    "type": "service_account",
    "project_id": "casazza-identity",
    "private_key_id": "...",
    "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
    "client_email": "crosswords-ci@casazza-identity.iam.gserviceaccount.com",
    "client_id": "...",
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/crosswords-ci%40casazza-identity.iam.gserviceaccount.com"
  }
